#!/bin/sh
mode="${1:-vnc}"
: > /tmp/trace.log
exec >>/tmp/trace.log 2>&1

say() {
  echo "matrux $(date +%H:%M:%S 2>/dev/null): $*"
}

say "boot mode=$mode args=$*"

export HOME=/root
export USER=root
export TMPDIR=/tmp
export XDG_RUNTIME_DIR=/tmp/runtime-root
export XDG_DATA_DIRS=/usr/local/share:/usr/share
export XDG_CONFIG_DIRS=/etc/xdg
export XDG_CACHE_HOME=/tmp/.cache
export NO_AT_BRIDGE=1
export GIO_USE_VFS=local
export LANG=ru_RU.UTF-8
export LC_MESSAGES=ru_RU.UTF-8
mkdir -p "$XDG_RUNTIME_DIR" /tmp/.X11-unix "$XDG_CACHE_HOME"
chmod 700 "$XDG_RUNTIME_DIR"
chmod 1777 /tmp/.X11-unix

PIDS_FILE=/tmp/matrux-pids
BUS_FILE=/tmp/matrux-bus
GEOMETRY="${MATRUX_GEOMETRY:-1280x800}"
case "$GEOMETRY" in
  [0-9]*x[0-9]*) ;;
  *) GEOMETRY=1280x800 ;;
esac
GW=${GEOMETRY%x*}
GH=${GEOMETRY#*x}
MAXW=$GW
MAXH=$GH
[ "$GH" -gt "$MAXW" ] 2>/dev/null && MAXW=$GH
[ "$GW" -gt "$MAXH" ] 2>/dev/null && MAXH=$GW
[ -n "$MAXW" ] || MAXW=1280
[ -n "$MAXH" ] || MAXH=800

VPORT="${MATRUX_VNC_PORT:-5901}"
case "$VPORT" in
  ''|*[!0-9]*) VPORT=5901 ;;
esac
PORTHEX=$(printf '%04X' "$VPORT" 2>/dev/null)
XVNC=$(command -v Xvnc 2>/dev/null || command -v Xtigervnc 2>/dev/null)
XKIND=""
XLOG=""
VLOG=""
XPID=""
VPID=""
DESKPID=""
DISP=""
FOUND=""
VSTARTED=""
NORANDR=""
KEEP_POLKIT=""
POLKIT_GONE=""

live() {
  [ -n "$1" ] && [ -d "/proc/$1" ]
}

alive() {
  if live "$1"; then echo "pid=$1"; else echo none; fi
}

lock_pid() {
  [ -f "/tmp/.X$1-lock" ] || return 1
  tr -d ' \n' < "/tmp/.X$1-lock" 2>/dev/null
}

foreign_display() {
  pid=$(lock_pid "$1") || return 1
  [ -n "$pid" ] || return 1
  [ "$pid" = "$XPID" ] && return 1
  live "$pid" || return 1
  case "$(cat "/proc/$pid/comm" 2>/dev/null)" in
    X*) return 0 ;;
  esac
  return 1
}

desktop_up() {
  if command -v xprop >/dev/null 2>&1; then
    xprop -display "$DISP" -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q "window id" && return 0
    command -v xlsclients >/dev/null 2>&1 || return 1
  fi
  if command -v xlsclients >/dev/null 2>&1; then
    xlsclients -display "$DISP" 2>/dev/null | grep -q xfce4-panel && return 0
    return 1
  fi
  return 0
}

display_state() {
  if desktop_up; then up=yes; else up=no; fi
  if live "$DESKPID"; then al=yes; else al=no; fi
  say "state desktop=$up pid=$DESKPID alive=$al display=$DISP server=$XKIND"
}

track() {
  [ -n "$1" ] && echo "$1" >> "$PIDS_FILE" 2>/dev/null
}

clean_leftovers() {
  if [ -f "$PIDS_FILE" ]; then
    while read -r p; do
      [ -n "$p" ] && kill -9 "$p" 2>/dev/null
    done < "$PIDS_FILE"
    : > "$PIDS_FILE"
    sleep 0.3
  fi
  for n in 0 1 2 3; do
    if foreign_display "$n"; then
      say "display :$n занят другим X-сервером, не трогаю"
      continue
    fi
    rm -f "/tmp/.X$n-lock" "/tmp/.X11-unix/X$n" 2>/dev/null
  done
  rm -f "$BUS_FILE" 2>/dev/null
}

wait_socket() {
  i=0
  while [ "$i" -lt 100 ]; do
    if [ -S "/tmp/.X11-unix/X$1" ] && live "$XPID"; then sleep 0.5; return 0; fi
    live "$XPID" || return 1
    i=$((i + 1))
    sleep 0.2
  done
  return 1
}

proc_net_readable() {
  [ -n "$(head -n 1 /proc/net/tcp 2>/dev/null)" ]
}

port_listening() {
  for t in /proc/net/tcp /proc/net/tcp6; do
    grep -q ":$PORTHEX [0-9A-Fa-f]*:0000 0A" "$t" 2>/dev/null && return 0
  done
  [ -n "$VLOG" ] && grep -Eqs "Listening for VNC connections.* port ${VPORT}([^0-9]|\$)" "$VLOG" && return 0
  if command -v nc >/dev/null 2>&1 && ! proc_net_readable; then
    nc -z -w 1 127.0.0.1 "$VPORT" </dev/null >/dev/null 2>&1 && return 0
  fi
  return 1
}

port_checkable() {
  proc_net_readable || command -v nc >/dev/null 2>&1
}

wait_port() {
  i=0
  while [ "$i" -lt 75 ]; do
    live "$VPID" || return 1
    port_listening && return 0
    i=$((i + 1))
    sleep 0.2
  done
  live "$VPID" || return 1
  if ! port_checkable; then
    say "порт $VPORT проверить нечем, процесс $VPID жив"
    return 0
  fi
  say "порт $VPORT не слушается за 15 с"
  return 1
}

start_vnc() {
  VSTARTED=1
  VLOG=/tmp/x11vnc.log
  rm -f "$VLOG"
  x11vnc -display "$1" -localhost -rfbport "$VPORT" -forever -shared -nopw -noshm -xrandr \
    -xdamage -defer 5 -nowf -nowcr -noxrecord -nobell -o "$VLOG" >/dev/null 2>&1 &
  VPID=$!
  track "$VPID"
}

start_desktop() {
  say "desktop start dbus-run-session xfce4-session (display $DISP)"
  rm -f "$BUS_FILE"
  dbus-run-session -- sh -c "echo \"\$DBUS_SESSION_BUS_ADDRESS\" > $BUS_FILE; exec xfce4-session" >/tmp/xfce.log 2>&1 &
  DESKPID=$!
  track "$DESKPID"
}

kill_desktop() {
  [ -n "$DESKPID" ] && kill -TERM "$DESKPID" 2>/dev/null && sleep 0.5
  for p in "$VPID" "$DESKPID" "$XPID"; do
    [ -n "$p" ] && kill -9 "$p" 2>/dev/null
  done
  for d in /proc/[0-9]*; do
    case "$(cat "$d/comm" 2>/dev/null)" in
      xfwm4|xfdesktop|xfce4-panel|xfce4-session|xfsettingsd|xfconfd|xfce4-notifyd|xfce4-power-man*|dbus-daemon|dbus-run-session) kill -9 "${d#/proc/}" 2>/dev/null ;;
    esac
  done
  rm -f "$BUS_FILE"
  sleep 0.5
}

fb_size() {
  xrandr -d "$DISP" -q 2>/dev/null | sed -n 's/.*current \([0-9]*\) x \([0-9]*\),.*/\1x\2/p' | head -n 1
}

resize_fb() {
  command -v xrandr >/dev/null 2>&1 || return 1
  i=0
  while [ "$i" -lt 15 ]; do
    xrandr -d "$DISP" --fb "$1" >/dev/null 2>&1
    [ "$(fb_size)" = "$1" ] && return 0
    i=$((i + 1))
    sleep 0.2
  done
  return 1
}

prepare_x() {
  command -v setxkbmap >/dev/null 2>&1 && \
    DISPLAY="$DISP" setxkbmap -layout us,ru -option grp:alt_shift_toggle -option grp_led:scroll >/dev/null 2>&1
  command -v xrdb >/dev/null 2>&1 && DISPLAY="$DISP" xrdb -merge /root/.Xresources >/dev/null 2>&1
  return 0
}

start_xvnc() {
  XKIND=xvnc
  XLOG=/tmp/xvnc.log
  VLOG=$XLOG
  say "Xvnc ${GEOMETRY} на $DISP"
  "$XVNC" "$DISP" -geometry "$GEOMETRY" -depth "${MATRUX_XVNC_DEPTH:-24}" -rfbport "$VPORT" \
    -SecurityTypes None -AlwaysShared -AcceptSetDesktopSize=1 -localhost=1 \
    -nolisten tcp -desktop Matrux -noreset >"$XLOG" 2>&1 &
  XPID=$!
  VPID=$XPID
  VSTARTED=1
  track "$XPID"
  wait_socket "${DISP#:}" && prepare_x
  return 0
}

start_xvfb() {
  XKIND=xvfb
  XLOG="/tmp/xvfb-${DISP#:}.log"
  SIZE="${MAXW}x${MAXH}"
  [ -n "$NORANDR" ] && SIZE="$GEOMETRY"
  say "Xvfb + x11vnc ${SIZE} на $DISP"
  Xvfb "$DISP" -screen 0 "${SIZE}x24" -nolisten tcp -ac >"$XLOG" 2>&1 &
  XPID=$!
  track "$XPID"
  wait_socket "${DISP#:}" || true
  start_vnc "$DISP"
  wait_port || true
  if [ "$SIZE" = "$GEOMETRY" ] || resize_fb "$GEOMETRY"; then
    say "framebuffer $GEOMETRY в экране $SIZE"
    prepare_x
    return 0
  fi
  live "$XPID" || return 0
  NORANDR=1
  say "xrandr не меняет размер Xvfb, запуск в $GEOMETRY"
  kill -9 "$VPID" "$XPID" 2>/dev/null
  sleep 0.3
  start_xvfb
}

start_display() {
  rm -f "/tmp/.X${DISP#:}-lock" "/tmp/.X11-unix/X${DISP#:}" "/tmp/xvfb-${DISP#:}.log" /tmp/xvnc.log
  if [ -n "$XVNC" ]; then
    start_xvnc
  else
    start_xvfb
  fi
}

rebuild_desktop() {
  kill_desktop
  reset_layout
  tune_speed
  start_display
}

resize_live() {
  W=${1%x*}
  H=${1#*x}
  case "$W$H" in *[!0-9]*) return 1 ;; esac
  [ "$W" -ge 320 ] 2>/dev/null || return 1
  [ "$H" -ge 320 ] 2>/dev/null || return 1
  command -v xrandr >/dev/null 2>&1 || return 1
  OUT=$(xrandr -d "$DISP" -q 2>/dev/null | sed -n 's/^\([^ ]*\) connected.*/\1/p' | head -n 1)
  [ -n "$OUT" ] || return 1
  NAME="matrux${W}x${H}"
  CLK=$((W * H * 60 / 1000000))
  [ "$CLK" -lt 10 ] && CLK=10
  xrandr -d "$DISP" --newmode "$NAME" "$CLK" "$W" $((W + 16)) $((W + 40)) $((W + 56)) "$H" $((H + 4)) $((H + 9)) $((H + 13)) >/dev/null 2>&1
  xrandr -d "$DISP" --addmode "$OUT" "$NAME" >/dev/null 2>&1
  xrandr -d "$DISP" --output "$OUT" --mode "$NAME" >/dev/null 2>&1
  i=0
  while [ "$i" -lt 8 ]; do
    [ "$(fb_size)" = "${W}x${H}" ] && break
    i=$((i + 1))
    sleep 0.15
  done
  [ "$(fb_size)" = "${W}x${H}" ] || return 1
  command -v xfdesktop >/dev/null 2>&1 && timeout 3 xfdesktop --reload >/dev/null 2>&1
  if command -v xrefresh >/dev/null 2>&1; then
    xrefresh -d "$DISP" >/dev/null 2>&1 &
  fi
  return 0
}

apply_geometry() {
  GEOMETRY="$1"
  GW=${GEOMETRY%x*}
  GH=${GEOMETRY#*x}
  if [ "$XKIND" = xvnc ]; then
    if resize_live "$GEOMETRY"; then
      say "geometry $GEOMETRY живьём, без перезапуска"
      return 0
    fi
    say "geometry $GEOMETRY: живьём не вышло, перезапуск Xvnc с новым размером"
    rebuild_desktop
    start_desktop
    say "geometry $GEOMETRY готово"
    return 0
  fi
  if [ "$XKIND" = xvfb ] && [ -z "$NORANDR" ] && [ "$GW" -le "$MAXW" ] && [ "$GH" -le "$MAXH" ] && resize_fb "$GEOMETRY"; then
    say "geometry $GEOMETRY через xrandr"
    return 0
  fi
  [ "$GW" -gt "$MAXW" ] && MAXW=$GW
  [ "$GH" -gt "$MAXW" ] && MAXW=$GH
  MAXH=$MAXW
  XRESTARTS=0
  DRESTARTS=0
  UP=""
  say "geometry $GEOMETRY, xrandr не сработал, пересобираю рабочий стол"
  rebuild_desktop
  start_desktop
  say "geometry $GEOMETRY готово"
}

fix_network() {
  dns="${MATRUX_DNS:-}"
  cur=$(cat /etc/resolv.conf 2>/dev/null)
  case "$cur" in
    *127.0.0.53*|"") broken=1 ;;
    *) broken=0 ;;
  esac
  if [ "$broken" = "1" ] || [ -n "$dns" ]; then
    {
      for s in $(printf '%s' "$dns" | tr ',' ' '); do
        printf 'nameserver %s\n' "$s"
      done
      printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n'
    } > /etc/resolv.conf 2>/dev/null
    say "сеть: DNS прописан (${dns:-без подсказки хоста})"
  fi
  if [ -f /etc/gai.conf ]; then
    grep -q '^[[:space:]]*precedence ::ffff:0:0/96' /etc/gai.conf 2>/dev/null ||
      printf 'precedence ::ffff:0:0/96  100\n' >> /etc/gai.conf 2>/dev/null
  else
    printf 'precedence ::ffff:0:0/96  100\n' > /etc/gai.conf 2>/dev/null
  fi
  if [ -d /etc/apt/apt.conf.d ]; then
    printf 'Acquire::ForceIPv4 "true";\n' > /etc/apt/apt.conf.d/99matrux-ipv4 2>/dev/null
  fi
  return 0
}

tune_speed() {
  home="${HOME:-/root}"
  dst="$home/.config/autostart"
  mkdir -p "$dst" 2>/dev/null
  for n in xfce4-power-manager xfce4-notifyd xfce4-screensaver light-locker xscreensaver \
           gvfs-gphoto2-volume-monitor gvfs-afc-volume-monitor gvfs-metadata gvfsd-fuse \
           gnome-keyring-ssh gnome-keyring-secrets blueman-applet xiccd gvfs-udisks2-volume-monitor; do
    printf '[Desktop Entry]\nType=Application\nName=%s\nHidden=true\n' "$n" > "$dst/$n.desktop" 2>/dev/null
  done
  rm -f "$home/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml" 2>/dev/null
  xml="$home/.config/xfce4/xfconf/xfce-perchannel-xml"
  if [ ! -f "$xml/xfwm4.xml" ]; then
    mkdir -p "$xml" 2>/dev/null
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
      '<channel name="xfwm4" version="1.0">' \
      '  <property name="general" type="empty">' \
      '    <property name="use_compositing" type="bool" value="false"/>' \
      '  </property>' \
      '</channel>' > "$xml/xfwm4.xml" 2>/dev/null
  fi
}

tune_xfce() (
  command -v xfconf-query >/dev/null 2>&1 || { say "tune: нет xfconf-query, пропуск"; exit 0; }
  bus=$(cat "$BUS_FILE" 2>/dev/null)
  [ -n "$bus" ] || { say "tune: нет адреса сессионной шины, пропуск"; exit 0; }
  export DBUS_SESSION_BUS_ADDRESS="$bus"
  q() { xfconf-query -c "$1" -p "$2" -n -t "$3" -s "$4" >/dev/null 2>&1; }
  q xfwm4 /general/use_compositing bool false
  q xfwm4 /general/show_frame_shadow bool false
  q xfwm4 /general/show_popup_shadow bool false
  q xfwm4 /general/box_move bool false
  q xfwm4 /general/box_resize bool false
  q xfwm4 /general/cycle_draw_frame bool false
  q xfwm4 /general/snap_to_border bool false
  q xfwm4 /general/snap_to_windows bool false
  q xfwm4 /general/wrap_resistance bool false
  q xfwm4 /general/frame_opacity int 100
  q xfwm4 /general/move_opacity int 100
  q xfwm4 /general/resize_opacity int 100
  q xfce4-panel /panels/panel-1/enter-opacity int 100
  q xfce4-panel /panels/panel-1/leave-opacity int 100
  q xsettings /Gtk/EnableAnimations bool false
  q xsettings /Net/CursorBlink bool false
  for p in $(xfconf-query -c xfdesktop -l 2>/dev/null | grep -E '/(image-style|color-style)$|/show-image-thumbnails$'); do
    case "$p" in
      *image-style) xfconf-query -c xfdesktop -p "$p" -n -t int -s 5 >/dev/null 2>&1 ;;
      *color-style) xfconf-query -c xfdesktop -p "$p" -n -t int -s 0 >/dev/null 2>&1 ;;
      *show-image-thumbnails) xfconf-query -c xfdesktop -p "$p" -n -t string -s never >/dev/null 2>&1 ;;
    esac
  done
  if [ "$(xfconf-query -c xfwm4 -p /general/use_compositing 2>/dev/null)" = false ]; then
    say "tune: композитор и анимации выключены"
  else
    say "tune: xfconf не ответил, композитор не тронут"
  fi
)

trim_daemons() {
  gone=""
  for d in /proc/[0-9]*; do
    pid=${d#/proc/}
    [ "$pid" = "$$" ] && continue
    c=$(cat "$d/comm" 2>/dev/null) || continue
    case "$c" in
      sshd|cups*|avahi-daemon|bluetoothd|tracker*|gvfsd*|gvfs-udisks*|gnome-keyring*|packagekitd|unattended-upgr*|ModemManager|wpa_supplicant|chronyd|systemd-timesyn*|upowerd|xiccd|tumblerd|gpg-agent|dconf-service|geoclue*|xdg-desktop-portal*|at-spi*) ;;
      polkitd)
        [ -n "$KEEP_POLKIT" ] && continue
        POLKIT_GONE=1 ;;
      *) continue ;;
    esac
    kill -TERM "$pid" 2>/dev/null && gone="$gone $c:$pid"
  done
  [ -n "$gone" ] && say "службы погашены:$gone"
  return 0
}

reset_layout() {
  home="${HOME:-/root}"
  dst="$home/.config/xfce4/xfconf/xfce-perchannel-xml"
  mark="$home/.config/matrux-defaults"
  [ -f "$mark" ] && return 0
  if [ -f /etc/matrux/xfce4-panel.xml ] || [ -f /etc/matrux/xfce4-desktop.xml ]; then
    mkdir -p "$dst" 2>/dev/null
    for f in xfce4-panel.xml xfce4-desktop.xml; do
      [ -f "/etc/matrux/$f" ] && cp -f "/etc/matrux/$f" "$dst/$f" 2>/dev/null
    done
    : >"$mark" 2>/dev/null
    return 0
  fi
  rm -f "$dst/xfce4-panel.xml" "$dst/xfce4-desktop.xml"
  rm -rf "$home/.config/xfce4/panel"
  rm -f "$home/.local/share/applications/xfce4-terminal.desktop"
  rm -f "$home/.config/xfce4/terminal/terminalrc"
  mkdir -p "$home/.config" 2>/dev/null
  : >"$mark" 2>/dev/null
}

clean_leftovers
reset_layout
fix_network
tune_speed
printf 'Xft.dpi: 96\nXft.antialias: 1\nXft.hinting: 1\nXft.rgba: rgb\nXcursor.size: 24\n' > /root/.Xresources

if [ "$mode" = "x11" ]; then
  rm -f /tmp/xvfb-0.log
  Xvfb ":0" -screen 0 "${MAXW}x${MAXH}x24" -nolisten tcp -ac >/tmp/xvfb-0.log 2>&1 &
  XPID=$!
  track "$XPID"
  wait_socket 0 || true
  export DISPLAY=:0
  exec dbus-run-session -- xfce4-session
fi

for d in 0 1 2; do
  if foreign_display "$d"; then
    say "display :$d занят, пропуск"
    continue
  fi
  DISP=":$d"
  start_display
  if live "$XPID" && wait_port; then
    FOUND=1
    break
  fi
  say "display :$d не поднялся (x=$(alive "$XPID") vnc=$(alive "$VPID") server=$XKIND)"
  kill -9 "$VPID" "$XPID" 2>/dev/null
  XPID=""
  VPID=""
done

if [ -z "$FOUND" ]; then
  say "no listener on $VPORT x=$(alive "$XPID") vnc=$(alive "$VPID") started=${VSTARTED:-no}"
  for n in 0 1 2; do
    [ -s "/tmp/xvfb-${n}.log" ] && tail -n 3 "/tmp/xvfb-${n}.log"
  done
  [ -s /tmp/xvnc.log ] && tail -n 5 /tmp/xvnc.log
  grep -iE "error|fail|cannot|unable|refus|fatal|denied|invalid|no such|in use" /tmp/x11vnc.log 2>/dev/null | tail -n 3
  exit 1
fi

say "vnc listening on $VPORT display $DISP geometry $GEOMETRY server=$XKIND"

export DISPLAY="$DISP"

XRESTARTS=0
DRESTARTS=0
STABLE=0
UP=""
WAITED=0
rm -f /tmp/geometry-request

start_desktop

while :; do
  if ! live "$XPID"; then
    if [ "$XRESTARTS" -lt 4 ]; then
      XRESTARTS=$((XRESTARTS + 1))
      say "X server lost, restart $XRESTARTS"
      kill -9 "$VPID" 2>/dev/null
      start_display
      wait_port || true
      UP=""
      continue
    fi
    say "X server lost, exit"
    exit 1
  fi

  if ! live "$VPID"; then
    say "x11vnc lost, restart"
    VPID=""
    start_vnc "$DISP"
    wait_port || true
    UP=""
    continue
  fi

  if live "$DESKPID"; then
    if [ -z "$UP" ] && desktop_up; then
      UP=1
      say "desktop up pid=$DESKPID"
      tune_xfce
      trim_daemons
    fi
  else
    if [ -n "$UP" ]; then
      say "desktop lost"
      UP=""
      if [ -n "$POLKIT_GONE" ] && [ -z "$KEEP_POLKIT" ]; then
        KEEP_POLKIT=1
        say "polkitd больше не гасим"
      fi
    fi
    if [ "$DRESTARTS" -lt 40 ]; then
      DRESTARTS=$((DRESTARTS + 1))
      say "desktop restart $DRESTARTS"
      sleep 1
      start_desktop
    else
      say "desktop restart limit reached"
      display_state
    fi
  fi

  if [ -z "$UP" ]; then
    WAITED=$((WAITED + 1))
    if [ "$WAITED" -eq 45 ]; then
      say "desktop not up after 45s"
      display_state
      tail -n 3 "$XLOG" 2>/dev/null
    fi
  fi

  if [ -n "$UP" ]; then
    STABLE=$((STABLE + 2))
    [ "$STABLE" -eq 60 ] && trim_daemons
    [ "$STABLE" -ge 300 ] && { XRESTARTS=0; DRESTARTS=0; }
  else
    STABLE=0
  fi

  if [ -f /tmp/geometry-request ]; then
    REQ=$(tr -d ' \n' < /tmp/geometry-request 2>/dev/null)
    rm -f /tmp/geometry-request
    case "$REQ" in
      [0-9]*x[0-9]*)
        if [ "$REQ" != "$GEOMETRY" ]; then
          RW=${REQ%x*}
          RH=${REQ#*x}
          case "$RW$RH" in
            *[!0-9]*) ;;
            *) if [ "$RW" -ge 320 ] 2>/dev/null && [ "$RH" -ge 320 ] 2>/dev/null; then
                 apply_geometry "$REQ"
                 continue
               fi ;;
          esac
        fi ;;
    esac
  fi

  n=0
  while [ "$n" -lt 10 ] && [ ! -f /tmp/geometry-request ]; do
    sleep 0.2
    n=$((n + 1))
  done
done
